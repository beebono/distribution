. config/functions

mkimage_uboot() {
  if [ "${DEVICE}" = "T618" ]; then
    # Unisoc UMS512: the SPL (already flashed to eMMC) boots u-boot from the SD
    # card by scanning its GPT for a partition literally named "uboot" (the
    # hybrid path: secure world from eMMC, u-boot from SD). That path runs
    # *before* the eMMC uboot_a/b slots, so it wins over the stock u-boot. The
    # raw sector-200 read is only a fallback gated behind an eMMC-uboot failure,
    # so it never fires on a device with an intact stock eMMC - hence a real
    # partition rather than a raw offset.
    #
    # The GPT (system=1, storage=2) already exists here; add "uboot" in the
    # empty pre-system gap. parted takes the next free slot (3) and does not
    # renumber system/storage, and the SPL matches by name regardless. The image
    # is the DHTB-wrapped u-boot from dhtb_pack.py: a 512-byte header
    # (== KEY_INFO_SIZ, magic "DHTB" + mImgSize) followed by the raw payload,
    # exactly the layout load_partition_with_header() expects (header at
    # partition offset 0, payload jumped to at CONFIG_SYS_TEXT_BASE).
    local UBOOT_PART_START=2048           # 1 MiB in; clear of the GPT (ends s33)
    local UBOOT_PART_SECTORS=4096         # 2 MiB; payload is <1 MiB (UBOOT_MAX_SIZE)
    local UBOOT_PART_END=$((UBOOT_PART_START + UBOOT_PART_SECTORS - 1))

    echo "image: creating uboot partition on $(basename "${DISK}")..."
    parted -s "${DISK}" -a min unit s mkpart uboot ${UBOOT_PART_START} ${UBOOT_PART_END} >"${SAVE_ERROR}" 2>&1 || show_error

    echo "image: writing uboot.bin into the uboot partition..."
    dd if="${RELEASE_DIR}/3rdparty/bootloader/uboot.bin" of="${DISK}" bs=512 seek=${UBOOT_PART_START} conv=fsync,notrunc >"${SAVE_ERROR}" 2>&1 || show_error
  elif [ -f "${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_uboot.bin" ]; then
    # RK3566-Generic and RK3566-Powkiddy_x55
    echo "image: writing ${SUBDEVICE}_uboot.bin to $(basename "${DISK}")..."
    dd if="${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_uboot.bin" of="${DISK}" bs=512 seek=64 conv=sync,noerror,notrunc >"${SAVE_ERROR}" 2>&1 || show_error
  elif [ -f "${RELEASE_DIR}/3rdparty/bootloader/uboot.bin" ]; then
    echo "image: writing uboot.bin to $(basename "${DISK}")..."
    dd if="${RELEASE_DIR}/3rdparty/bootloader/uboot.bin" of="${DISK}" bs=512 seek=64 conv=sync,noerror,notrunc >"${SAVE_ERROR}" 2>&1 || show_error
  elif [ -f "${RELEASE_DIR}/3rdparty/bootloader/u-boot.bin" ]; then
    # S922X
    echo "image: writing u-boot.bin to $(basename "${DISK}")..."
    dd if="${RELEASE_DIR}/3rdparty/bootloader/u-boot.bin" of="${DISK}" bs=512 seek=1 conv=sync,noerror,notrunc >"${SAVE_ERROR}" 2>&1 || show_error
  elif [ -f "${RELEASE_DIR}/3rdparty/bootloader/H700_${SUBDEVICE}_u-boot-sunxi-with-spl.bin" ]; then
    # H700
    echo "image: writing u-boot-sunxi-with-spl.bin to $(basename "${DISK}")..."
    dd if="${RELEASE_DIR}/3rdparty/bootloader/H700_${SUBDEVICE}_u-boot-sunxi-with-spl.bin" of="${DISK}" bs=1K seek=8 conv=fsync,notrunc >"${SAVE_ERROR}" 2>&1 || show_error
  elif [ -f "${RELEASE_DIR}/3rdparty/bootloader/rocknix-u-boot.img" ]; then
    # SM8750, SM8650 & SM8550
    echo "image: copying rocknix u-boot files..."
    mcopy -o "${RELEASE_DIR}/3rdparty/bootloader/rocknix-u-boot.img" ::
    mcopy -s -o "${RELEASE_DIR}/3rdparty/bootloader/device_trees" ::
  else
    echo "ERROR no u-boot file found for ${SUBDEVICE}"
  fi
}

mkimage_extlinux() {
  if [ -d "${RELEASE_DIR}/3rdparty/bootloader/extlinux" ]; then
    echo "image: copying custom extlinux.conf..."
    mcopy -s -o "${RELEASE_DIR}/3rdparty/bootloader/extlinux" ::
  else
    local fdt_type
    local fdt_overlays
    fdt_type=$(get_fdt_type)
    fdt_overlays=$(get_fdt_overlays)

    echo "image: set extlinux.conf to $fdt_type /$(get_fdt)..."
    mkdir -p "${IMG_TMP}/extlinux"

    cat << EOF > "${IMG_TMP}/extlinux/extlinux.conf"
LABEL ${DISTRO}
  LINUX /${KERNEL_NAME}
  ${fdt_type} /$(get_fdt)
  APPEND boot=LABEL=${DISTRO_BOOTLABEL} disk=LABEL=${DISTRO_DISKLABEL} ${EXTRA_CMDLINE}
EOF

    if [[ -n "${fdt_overlays}" ]]; then
      cat << EOF >> "${IMG_TMP}/extlinux/extlinux.conf"
  FDTOVERLAYS /overlays/${fdt_overlays}
EOF
    fi

    echo "image: copying extlinux.conf..."
    mcopy -s -o "${IMG_TMP}/extlinux" ::
  fi
}

mkimage_bootscr() {
  if [ -f "${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_boot.scr" ]; then
    echo "image: copying ${SUBDEVICE}_boot.scr..."
    mcopy "${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_boot.scr" ::/boot.scr
  else
    echo "cannot find ${RELEASE_DIR}/3rdparty/bootloader/${SUBDEVICE}_boot.scr"
    exit 2
  fi
}

mkimage_dtb() {
  echo "image: copying device trees..."
  case "$DEVICE" in
    RK3326)
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/device_trees/"*.dtb ::
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/stock" ::
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/overlays" ::
      ;;
    SM8550|SM8650|SM8750|SM8250|SM6115)
      mcopy -s -o "${RELEASE_DIR}/3rdparty/bootloader/boot" ::
      ;;
    S922X)
      mcopy "${RELEASE_DIR}/3rdparty/bootloader/"*.dtb ::
      ;;
    *)
      mcopy -s "${RELEASE_DIR}/3rdparty/bootloader/device_trees" ::
      ;;
  esac

  if [ -d "${RELEASE_DIR}/3rdparty/bootloader/overlays" ]; then
    echo "image: copying device tree overlays..."
    mcopy -s "${RELEASE_DIR}/3rdparty/bootloader/overlays" ::
  fi
}

mkimage_grub() {
  echo "image: copying grub files and dtb..."
  mcopy -s -o "${RELEASE_DIR}/3rdparty/bootloader/EFI" ::
}

mkimage_abl() {
  echo "image: copying ROCKNIX ABL..."
  mcopy "${RELEASE_DIR}/3rdparty/bootloader/rocknix_abl" ::
}

mkimage_all
