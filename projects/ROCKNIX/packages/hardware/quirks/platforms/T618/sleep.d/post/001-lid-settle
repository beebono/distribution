# Half two of the hall-swivel settle window (see pre/002-lid-settle).
#
# Hold the device back for a moment, then decide whether this wake was
# real. If the lid is shut when the window closes and nothing else claims
# the wake, go straight back to suspend - the screen is still blanked
# from the pre half and the inputs are grabbed, so the whole episode is
# invisible. Otherwise hand the device back to the user.
#
# The settle runs in a transient unit, not a background job. This hook
# executes inside systemd-suspend.service, a oneshot with the default
# KillMode=control-group: when the hooks return, systemd kills every
# process still in that cgroup. A plain '&' - even behind setsid, which
# changes the session and not the cgroup - is SIGTERMed within
# milliseconds of this script exiting, which leaves the backlight blanked
# with nobody alive to restore it. systemd-run puts the settle under
# system.slice, where it outlives the sleep operation.
#
# Returning immediately also keeps us clear of the InhibitDelayMaxSec
# budget (5s default) that logind gives the whole resume, so the settle
# length is free to tune.
#
# Deliberately biased towards staying awake. Every uncertain case -
# unknown wake source, missing lid device, systemd-run refusing to
# start - releases and lights the screen. A device that wakes when it
# should not is an annoyance; one that will not stay awake is unusable.
#
# Ordered BEFORE audio on this half, so we don't blare something through
# the speaker on accident.

. /etc/profile

LID_STATE_FILE="/run/.lid_settle_state"
LID_ACTIVE_FILE="/run/.lid_settle_active"
USB_POWER_FILE="/run/.usb_settle_power"
USB_DATA_FILE="/run/.usb_settle_data"
LID_ROTATE="/usr/lib/autostart/quirks/platforms/T618/bin/lid-rotate"
LED_STATUS="/usr/bin/battery_led_status"

SETTLE_MS="$(get_setting system.lid.settle_ms)"
[ -z "${SETTLE_MS}" ] && SETTLE_MS=750

# Wake on a charger plug or unplug purely to refresh the charging LED,
# then go straight back to sleep; do the same silently for a data-only
# plug or unplug. 0 disables, leaving every usb wake to keep the device
# awake as it did before.
USB_AUTOSLEEP="$(get_setting system.usb.autosleep)"
[ -z "${USB_AUTOSLEEP}" ] && USB_AUTOSLEEP=1

RESUSPEND=0

release() {
  pkill -f "evtest --grab" >/dev/null 2>&1
  for BL in /sys/class/backlight/*/bl_power; do
    [ -e "${BL}" ] && echo 0 >"${BL}"
  done
  rm -f "${LID_STATE_FILE}" "${LID_ACTIVE_FILE}" \
        "${USB_POWER_FILE}" "${USB_DATA_FILE}"
  # Reconcile orientation against the level we are actually resuming at.
  # The kernel re-reports SW_LID on every resume, but the input core
  # drops an EV_SW event whose value has not changed, so the watcher has
  # nothing to react to when the lid comes back the way it went down.
  #
  # Synchronous on purpose. Backgrounding it would put the child in
  # whichever cgroup called us and it would be killed on the way out -
  # the same trap the settle itself fell into. sway is up by now, so the
  # call returns immediately; only the boot-time retry path is slow, and
  # that path cannot be reached from here.
  [ -x "${LID_ROTATE}" ] && "${LID_ROTATE}" --apply >/dev/null 2>&1
}

# Safety net for the settle child: if it is killed or dies part way
# through, the screen comes back rather than staying dark forever. Only a
# deliberate re-suspend is allowed to leave it blanked.
on_exit() {
  [ "${RESUSPEND}" = "1" ] && return
  release
}

lid_device() {
  local cap sw dev
  for cap in /sys/class/input/event*/device/capabilities/sw; do
    [ -e "${cap}" ] || continue
    read -r sw <"${cap}"
    sw="${sw##* }"
    [ $(( 0x${sw} & 1 )) -eq 1 ] || continue
    dev="${cap%/device/capabilities/sw}"
    echo "/dev/input/${dev##*/}"
    return 0
  done
  return 1
}

# What woke us, by name. Needs CONFIG_PM_SLEEP_DEBUG, which this device
# carries for the section 2 work. Empty when the firmware woke us
# without a linux irq ever firing, which does happen here.
wake_source() {
  local irq
  read -r irq </sys/power/pm_wakeup_irq 2>/dev/null || return 1
  [ -n "${irq}" ] || return 1
  # Everything after the per-cpu counts: chip, trigger type, and the
  # requesting device. The count column width varies with cpu count, so
  # skip leading numeric fields rather than a fixed offset.
  awk -v i="${irq}:" '$1 == i {
    out = ""; seen = 0
    for (n = 2; n <= NF; n++) {
      if (!seen && $n ~ /^[0-9]+$/) continue
      seen = 1
      out = out (out == "" ? "" : " ") $n
    }
    print out; exit
  }' /proc/interrupts
}

# Mirrors of the two recorders in pre/002-lid-settle. See the long comment
# there for why the state is split into power and data, and why battery
# current/voltage are excluded.
usb_power_state() {
  local f
  for f in /sys/class/power_supply/*/online; do
    [ -r "${f}" ] && echo "${f}=$(cat ${f} 2>/dev/null)"
  done
}

usb_data_state() {
  local f d
  for f in /sys/class/usb_role/*/role; do
    [ -r "${f}" ] && echo "${f}=$(cat ${f} 2>/dev/null)"
  done
  for d in /sys/class/typec/*-partner; do
    [ -d "${d}" ] && echo "partner=${d}"
  done
  for d in /sys/bus/usb/devices/*; do
    case "${d##*/}" in
      *:*) continue ;;
    esac
    [ -d "${d}" ] && echo "dev=${d##*/}"
  done
}

# 'charger', 'data' or empty. Checked after the settle window has already
# elapsed, so PD negotiation has finished and the charger psy has caught
# up - reading it any earlier races the contract.
#
# Power is tested first and wins: a charger attach moves the data state
# too (the role goes to 'device', a partner appears), so testing data
# first would misfile every charger event.
usb_verdict() {
  [ "${USB_AUTOSLEEP}" = "0" ] && return 0
  [ -e "${USB_POWER_FILE}" ] || return 0

  if [ "$(usb_power_state 2>/dev/null)" != "$(cat ${USB_POWER_FILE} 2>/dev/null)" ]; then
    echo "charger"
  elif [ "$(usb_data_state 2>/dev/null)" != "$(cat ${USB_DATA_FILE} 2>/dev/null)" ]; then
    echo "data"
  fi
}

# Give the device straight back to suspend. The backlight is deliberately
# left blanked - it is about to be irrelevant, and not touching it means
# the screen never flickers on a rejected wake.
resuspend() {
  RESUSPEND=1
  pkill -f "evtest --grab" >/dev/null 2>&1
  rm -f "${LID_STATE_FILE}" "${LID_ACTIVE_FILE}" \
        "${USB_POWER_FILE}" "${USB_DATA_FILE}"
  systemctl suspend
}

settle() {
  trap on_exit EXIT TERM INT

  local LID_DEV WAS WOKE DEV
  LID_DEV="$(lid_device)"

  if [ -z "${LID_DEV}" ]; then
    log $0 "Settle: no SW_LID device, staying awake."
    return
  fi

  # Take the inputs away for the duration of the window - everything
  # except the device carrying the lid, which also carries the power and
  # volume keys and has to keep reaching logind. The gamepad and the
  # touchscreen are what would do damage during a rejected wake. These
  # children share this unit's cgroup, so they die with it either way,
  # which is the failsafe against leaving the device ungrabbable.
  for DEV in /dev/input/event*; do
    [ "${DEV}" = "${LID_DEV}" ] && continue
    evtest --grab "${DEV}" >/dev/null 2>&1 &
  done

  # Let the resume finish before we consider asking for another suspend,
  # and give the hinge time to stop moving. Same delay serves both.
  sleep "$(awk -v ms="${SETTLE_MS}" 'BEGIN { print ms / 1000 }')"

  WAS="$(cat ${LID_STATE_FILE} 2>/dev/null)"
  WOKE="$(wake_source)"
  USB="$(usb_verdict)"

  # Level, not edge - the rule this whole section runs on. evtest --query
  # exits 10 when the switch is set, and set means closed.
  if evtest --query "${LID_DEV}" EV_SW SW_LID; then
    NOW="open"
  else
    NOW="closed"
  fi

  # Someone physically opened the swivel while we were down. That is an
  # unambiguous request for the device, and it outranks any usb event that
  # happened to land in the same window - plugging a charger in as you
  # open the lid must not put the device back to sleep in your hands.
  # Consistent with the bias everywhere else here: an unwanted wake is an
  # annoyance, a device that will not stay awake is unusable.
  if [ "${NOW}" = "open" ] && [ "${WAS}" = "closed" ]; then
    log $0 "Settle: lid opened (wake source '${WOKE:-unknown}', usb '${USB:-none}'), staying awake."
    return
  fi

  # Otherwise the usb verdict is checked before the lid, and regardless of
  # which way the lid is facing. The device can be asleep with the swivel
  # open - a power-key suspend leaves it that way - and a charger plugged
  # in then should still refresh the led and go back to sleep rather than
  # sitting awake on the user's desk.
  case "${USB}" in
    charger)
      # Synchronous, and before the re-suspend. The led daemon polls once
      # a second and is frozen across suspend, so it would never see this
      # charger state; and backgrounding anything here hits the same
      # KillMode=control-group trap the settle itself had to work around.
      if [ -x "${LED_STATUS}" ]; then
        "${LED_STATUS}" --once >/dev/null 2>&1
      fi
      log $0 "Settle: charger plug/unplug (wake source '${WOKE:-unknown}'), led refreshed, suspending again."
      resuspend
      return
      ;;
    data)
      log $0 "Settle: data-only plug/unplug (wake source '${WOKE:-unknown}'), suspending again."
      resuspend
      return
      ;;
  esac

  if [ "${NOW}" = "open" ]; then
    log $0 "Settle: lid open (was ${WAS:-unknown}, wake source '${WOKE:-unknown}'), staying awake."
    return
  fi

  # Lid is shut, so this is a rejected wake only if the lid is also what
  # woke us. Match that positively rather than by excluding the pmic:
  # measured on hardware, a lid wake resolves to 'sprd-gpio 54 Edge Hall
  # Swivel' - the pin and the gpio-keys label - and the power key to
  # 'GICv3 205 Level spi0.0'. Anything else that wakes the device while
  # the lid happens to be shut (rtc, charger, whatever comes later) asked
  # to be awake for its own reasons and gets to stay awake.
  case "${WOKE}" in
    *"Hall Swivel"*) ;;
    "")
      log $0 "Settle: lid shut but wake source unknown, staying awake."
      return
      ;;
    *)
      log $0 "Settle: lid shut but '${WOKE}' claimed the wake, staying awake."
      return
      ;;
  esac

  log $0 "Settle: lid shut after ${SETTLE_MS}ms (was ${WAS:-unknown}, wake source '${WOKE}'), suspending again."
  resuspend
}

# Nothing to undo - the pre half bailed out, or the settle is disabled.
if [ ! -e "${LID_ACTIVE_FILE}" ]; then
  exit 0
fi

if [ "$1" = "--settle" ]; then
  settle
  exit 0
fi

# --collect reaps the unit when it finishes, so the fixed name is free
# again next time. If it will not start at all, do not leave the screen
# dark: release here and now, synchronously, and skip the window.
if ! systemd-run --quiet --collect --unit=lid-settle \
       "$(readlink -f "$0")" --settle; then
  log $0 "Settle: systemd-run failed, releasing without a settle window."
  release
fi
exit 0
