# Half one of the hall-swivel settle window (see post/001-lid-settle).
#
# The swivel hinge is loose enough that a pocket knock can crack it open
# and let it fall shut again. The opening edge is a wake source - it has
# to be, that is how you turn the device on - and the wake is signalled
# from the gpio-keys isr before any debounce runs, so nothing downstream
# can suppress it. What we can do is refuse to *commit* to the wake until
# the lid has held one state for a moment.
#
# This half does two things and starts no processes: record which way the
# lid was facing when we went down, and blank the backlight so a rejected
# wake never lights the screen. Blanking here rather than on resume is
# deliberate - the panel is brought back up during kernel resume, long
# before any userspace sleep hook runs, so the only way to keep the
# screen dark across a wake is to have left it dark going in.
#
# Nothing may be backgrounded from here. systemd-suspend.service is a
# oneshot with the default KillMode=control-group, so every process still
# in its cgroup is killed the moment the hooks return - setsid does not
# help, it changes the session and not the cgroup. Anything that has to
# outlive the hook goes in a transient unit, which is what the post half
# does with the settle itself.

. /etc/profile

LID_STATE_FILE="/run/.lid_settle_state"
LID_ACTIVE_FILE="/run/.lid_settle_active"
USB_POWER_FILE="/run/.usb_settle_power"
USB_DATA_FILE="/run/.usb_settle_data"

SETTLE_MS="$(get_setting system.lid.settle_ms)"
[ -z "${SETTLE_MS}" ] && SETTLE_MS=750

# Disabled - leave the display alone entirely.
if [ "${SETTLE_MS}" = "0" ]; then
  rm -f "${LID_STATE_FILE}" "${LID_ACTIVE_FILE}" \
        "${USB_POWER_FILE}" "${USB_DATA_FILE}"
  exit 0
fi

# The event device carrying SW_LID, found by capability rather than by
# name: both gpio-keys nodes on this board present as "gpio-keys", so
# the name does not identify one. SW_LID is bit 0 of the EV_SW mask.
lid_device() {
  local cap sw dev
  for cap in /sys/class/input/event*/device/capabilities/sw; do
    [ -e "${cap}" ] || continue
    read -r sw <"${cap}"
    sw="${sw##* }"
    [ $(( 0x${sw} & 1 )) -eq 1 ] || continue
    dev="${cap%/device/capabilities/sw}"
    echo "/dev/input/${dev##*/}"
    return 0
  done
  return 1
}

# USB/charger state, recorded so the post half can tell what a wake was
# for. It cannot ask: the power key, the charger, the fuel gauge and the
# Type-C controller are all children of the one PMIC irq, so every one of
# them - measured, including with musb's own wakeup armed - resolves to
# the same 'GICv3 205 Level spi0.0' in pm_wakeup_irq. There is nothing to
# discriminate on there, so we diff state instead.
#
# Split in two because the two halves mean different things:
#
#   power - any supply's 'online'. Flips only for a charger, on both the
#           charger psy and the tcpm source psy, and never for a data-only
#           attach. Globbed rather than named: the charger registers as
#           'aw32257-0' (an awinic variant handled by bq2415x_charger.c,
#           bq->charger_desc.name = bq->name), which is neither stable nor
#           guessable.
#   data  - the usb role, the Type-C partner directory, and the set of
#           attached usb devices. Any of these moving with 'online' steady
#           is a data-only plug or unplug.
#
# Battery current_now/voltage_now are deliberately *not* recorded. They
# drift on every single wake including a plain power-key press, so
# including them would make every wake look like a usb event.
usb_power_state() {
  local f
  for f in /sys/class/power_supply/*/online; do
    [ -r "${f}" ] && echo "${f}=$(cat ${f} 2>/dev/null)"
  done
}

usb_data_state() {
  local f d
  for f in /sys/class/usb_role/*/role; do
    [ -r "${f}" ] && echo "${f}=$(cat ${f} 2>/dev/null)"
  done
  for d in /sys/class/typec/*-partner; do
    [ -d "${d}" ] && echo "partner=${d}"
  done
  # Attached usb devices, skipping the ':'-suffixed interface directories.
  for d in /sys/bus/usb/devices/*; do
    case "${d##*/}" in
      *:*) continue ;;
    esac
    [ -d "${d}" ] && echo "dev=${d##*/}"
  done
}

usb_power_state >"${USB_POWER_FILE}" 2>/dev/null
usb_data_state  >"${USB_DATA_FILE}"  2>/dev/null

LID_DEV="$(lid_device)"
if [ -z "${LID_DEV}" ]; then
  log $0 "No SW_LID input device, skipping settle window."
  rm -f "${LID_STATE_FILE}" "${LID_ACTIVE_FILE}" \
        "${USB_POWER_FILE}" "${USB_DATA_FILE}"
  exit 0
fi

# evtest --query exits 10 when the switch is set. Set = closed.
if evtest --query "${LID_DEV}" EV_SW SW_LID; then
  echo "open" >"${LID_STATE_FILE}"
else
  echo "closed" >"${LID_STATE_FILE}"
fi
log $0 "Lid is $(cat ${LID_STATE_FILE}) going into suspend (${LID_DEV})."

for BL in /sys/class/backlight/*/bl_power; do
  [ -e "${BL}" ] && echo 4 >"${BL}"
done

touch "${LID_ACTIVE_FILE}"
