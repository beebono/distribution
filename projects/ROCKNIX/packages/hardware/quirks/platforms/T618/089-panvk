# panvk (mesa's Vulkan driver for Panfrost) is not yet conformant and refuses
# to load without this opt-in gate. T618 performs marginally better with it anyway.
cat <<EOF >/storage/.config/profile.d/089-panvk
export PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1
EOF
