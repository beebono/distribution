# UMS512 is 6x Cortex-A55 (policy0) + 2x Cortex-A75 (policy6). The cpufreq
# driver registers one policy per cluster, keyed on the policy-leader CPU.
cat <<EOF >/storage/.config/profile.d/010-governors
CPU_FREQ=("/sys/devices/system/cpu/cpufreq/policy0" "/sys/devices/system/cpu/cpufreq/policy6")
GPU_FREQ=("/sys/devices/platform/soc/60000000.gpu/devfreq/60000000.gpu")
EOF
